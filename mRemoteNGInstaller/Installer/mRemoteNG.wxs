<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?include $(sys.CURRENTDIR)Includes\Config.wxi?>
  <Package Name="$(var.ProductNameWithPlatform)" Manufacturer="Profi-Kom Ltd." Version="$(var.ProductVersion)" UpgradeCode="$(var.UpgradeCode)" Language="1033" InstallerVersion="200" ProductCode="$(var.ProductCode)">
    
    <MajorUpgrade DowngradeErrorMessage="!(loc.Upgrade_NewerVersionInstalled)" Schedule="afterInstallExecute" />
    <MediaTemplate EmbedCab="yes" />
    <Binary Id="CustomActions.CA.dll" SourceFile="$(var.InstallerSolutionDir)mRemoteNGInstaller\CustomActions\bin\x64\$(var.Configuration)\net481\CustomActions.CA.dll" />
    <Property Id="MsiLogging" Value="v" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="http://mremoteng.org" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize" />
    <Property Id="MAINEXE" Value="$(var.ExeProcessName)" />
    <Property Id="INSTALLDIR">
      <RegistrySearch Id="mRemoteNGRegistry" Type="raw" Root="HKLM" Key="Software\mRemoteNG" Name="InstallDir" />
    </Property>
    <Property Id="RDP_DTLS_KB" Value="$(var.RdpDtlsKb)" />
    <Property Id="RDP_DTLS_UPDATE_INSTALLED" Value="0" Secure="yes" />
    <Property Id="RDP80_KB" Value="$(var.Rdp80Kb)" />
    <Property Id="RDP81_KB" Value="$(var.Rdp81Kb)" />
    <Property Id="MINIMUM_RDP_VERSION_INSTALLED" Value="0" Secure="yes" />
    <Property Id="REQUIREDDOTNETFRAMEWORKVERSION" Value="$(var.RequiredDotNetFrameworkVersion)" />
    <Property Id="LEGACYVERSIONINSTALLED" Value="0" />
    <Icon Id="AppIcon.ico" SourceFile="Resources\AppIcon.ico" />
    <CustomActionRef Id="SaveCmdlineINSTALLDIR" />

    <InstallExecuteSequence>
      <Custom Action="CheckIfRdpDtlsUpdateInstalled" After="AppSearch" Condition="(NOT Installed) AND (VersionNT = 601 OR VersionNT64 = 601)" />
      <Custom Action="CheckIfMinimumRdpInstalled" After="CheckIfRdpDtlsUpdateInstalled" Condition="(NOT Installed) AND (VersionNT = 601 OR VersionNT64 = 601)" />
      <Custom Action="CheckIfLegacyVersionInstalled" After="LaunchConditions" />
      <Custom Action="UninstallLegacyVersion" After="CheckIfLegacyVersionInstalled" Condition="(NOT Installed) AND (LEGACYVERSIONINSTALLED = 1)" />
    </InstallExecuteSequence>

    <UI>
      <UIRef Id="WixUI_Common" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="EndDialog" Value="Return" />
    </UI>

    <Launch Condition="Privileged" Message="!(loc.Install_NeedToBeAdminToInstall)" />
    <Launch Condition="Installed OR (IGNOREPREREQUISITES = 1) OR (VersionNT &gt;= 601) OR (VersionNT64 &gt;= 601)" Message="!(loc.Install_OSVersionRequirement)" />
    <Launch Condition="Installed OR (IGNOREPREREQUISITES = 1) OR (VersionNT &gt;= 602 OR VersionNT64 &gt;= 602) OR ((VersionNT = 601 OR VersionNT64 = 601) AND ServicePackLevel &gt;= 1)" Message="!(loc.Install_Win7RequiresSP1)" />
    <Launch Condition="Installed OR (IGNOREPREREQUISITES = 1) OR (VersionNT &gt;= 602 OR VersionNT64 &gt;= 602) OR ((VersionNT = 601 OR VersionNT64 = 601) AND (RDP_DTLS_UPDATE_INSTALLED = 1))" Message="!(loc.Install_RDPDtlsRequirement)" />
    <Launch Condition="Installed OR (IGNOREPREREQUISITES = 1) OR (VersionNT &gt;= 602 OR VersionNT64 &gt;= 602) OR ((VersionNT = 601 OR VersionNT64 = 601) AND (MINIMUM_RDP_VERSION_INSTALLED = 1))" Message="!(loc.Install_RDP80Requirement)" />

    <Feature Id="F.MinimalFeature" Title="$(var.ProductName)" ConfigurableDirectory="INSTALLDIR" Display="expand" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="MandatoryComponents" Primary="yes" />
      <ComponentRef Id="C.MainExe" Primary="yes" />
      <ComponentGroupRef Id="CG.ProjectInfoFiles" Primary="yes" />
      <ComponentRef Id="C.RegistryEntries" Primary="yes" />
    </Feature>

    <Feature Id="F.DesktopShortcut" Title="!(loc.Feature_DesktopShortcut)" AllowAdvertise="no" Level="1">
      <ComponentRef Id="C.DesktopShortcut" Primary="yes" />
    </Feature>

    <Feature Id="F.ApplicationStartMenuShortcut" Title="!(loc.Feature_StartMenuShortcut)" AllowAdvertise="no" Level="1">
      <ComponentRef Id="C.ApplicationStartMenuShortcut" Primary="yes" />
    </Feature>
    
    <UI>
      <UIRef Id="My_WixUI_FeatureTree" />
      <UIRef Id="WixUI_ErrorProgressText" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>

    <WixVariable Id="WixUILicenseRtf" Value="Resources\License.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="Resources\Installer_Side.png" />
    <WixVariable Id="WixUIBannerBmp" Value="Resources\Installer_Header.png" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.FinishPage_LaunchMremoteNow)" />
    <Property Id="WixShellExecTarget" Value="[#MainExeFile]" />
    <CustomAction Id="LaunchApplication" DllEntry="WixShellExec" Impersonate="yes" BinaryRef="Wix4UtilCA_X86" />
  </Package>
</Wix>