<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>True</UseWindowsForms>
    <Platforms>x64;arm64</Platforms>
    <Configurations>Debug;Release;Release Self-Contained;Deploy to github</Configurations>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <AssemblyName>mRp.SshTransfer</AssemblyName>
    <RootNamespace>mRp.SshTransfer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Renci.SshNet.Async" />
    <PackageReference Include="SSH.NET" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\mRemoteNG.PluginContracts\mRemoteNG.PluginContracts.csproj" PrivateAssets="all" />
  </ItemGroup>
</Project>
